auto lo
iface lo inet loopback

auto {{ ansible_default_ipv4.interface }}
iface {{ ansible_default_ipv4.interface }} inet static
    address {{ address }}
    netmask {{ netmask }}
    gateway {{ gateway }}
    dns-nameservers {{ dns_nameservers | join(' ') }}

iface {{ ansible_default_ipv4.interface }} inet6 auto
